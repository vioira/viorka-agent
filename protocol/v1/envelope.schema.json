{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vioira.example/spec/viorka/agent/v1/envelope.schema.json",
  "title": "Viorka Agent Protocol v1 Envelope (design contract)",
  "description": "消息包装结构。约定协议目标，M0 期间实现握手和端到端联测。",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "message_id",
    "type",
    "sent_at",
    "payload"
  ],
  "properties": {
    "version": {
      "type": "string",
      "const": "1.0"
    },
    "message_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "type": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*)+$"
    },
    "node_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "correlation_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "sent_at": {
      "type": "string",
      "format": "date-time"
    },
    "revision": {
      "type": "integer",
      "minimum": 0
    },
    "payload": {
      "type": "object"
    }
  },
  "$defs": {
    "Hello": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "agent_version": {
          "type": "string"
        },
        "protocol_versions": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "maxItems": 32
        },
        "capabilities": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "maxItems": 32
        },
        "os": {
          "type": "string"
        },
        "arch": {
          "type": "string"
        }
      },
      "required": [
        "agent_version",
        "protocol_versions",
        "capabilities",
        "os",
        "arch"
      ]
    },
    "HelloAck": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "protocol_version": {
          "type": "string"
        },
        "heartbeat_seconds": {
          "type": "integer",
          "minimum": 0
        },
        "inventory_version": {
          "type": "integer",
          "enum": [
            1
          ]
        }
      },
      "required": [
        "protocol_version",
        "heartbeat_seconds"
      ]
    },
    "Heartbeat": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "observed_config_revision": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "observed_config_revision"
      ]
    },
    "TaskDispatch": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "task_id": {
          "type": "string"
        },
        "operation": {
          "type": "string"
        },
        "idempotency_key": {
          "type": "string"
        },
        "resource_kind": {
          "type": "string"
        },
        "resource_id": {
          "type": "string"
        },
        "config_sha256": {
          "type": "string"
        },
        "deadline_at": {
          "type": "string",
          "format": "date-time"
        },
        "attempt": {
          "type": "integer",
          "minimum": 0
        },
        "traffic_calibration": {
          "$ref": "#/$defs/TrafficCalibration"
        }
      },
      "required": [
        "task_id",
        "operation",
        "idempotency_key",
        "resource_kind",
        "resource_id",
        "deadline_at"
      ]
    },
    "Inspection": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "os": {
          "type": "string"
        },
        "arch": {
          "type": "string"
        },
        "hostname": {
          "type": "string"
        }
      },
      "required": [
        "os",
        "arch",
        "hostname"
      ]
    },
    "TaskReply": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "task_id": {
          "type": "string"
        },
        "attempt": {
          "type": "integer",
          "minimum": 0
        },
        "resource_id": {
          "type": "string"
        },
        "state": {
          "type": "string"
        },
        "inspection": {
          "$ref": "#/$defs/Inspection"
        },
        "error_code": {
          "type": "string"
        },
        "traffic_calibration": {
          "$ref": "#/$defs/TrafficCalibration"
        },
        "traffic_before": {
          "$ref": "#/$defs/TrafficCalibration"
        }
      },
      "required": [
        "task_id",
        "attempt",
        "resource_id",
        "state"
      ]
    },
    "NodeInventory": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "sampled_at": {
          "type": "string",
          "format": "date-time"
        },
        "os_id": {
          "type": "string",
          "maxLength": 64
        },
        "os_name": {
          "type": "string",
          "maxLength": 256
        },
        "os_version": {
          "type": "string",
          "maxLength": 64
        },
        "public_ipv4": {
          "type": "string",
          "maxLength": 45
        },
        "public_ipv6": {
          "type": "string",
          "maxLength": 45
        },
        "errors": {
          "type": "array",
          "maxItems": 3,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "enum": [
              "os_release_unavailable",
              "public_ipv4_unavailable",
              "public_ipv6_unavailable"
            ]
          }
        }
      },
      "required": [
        "sampled_at",
        "os_id",
        "os_name",
        "os_version",
        "public_ipv4",
        "public_ipv6",
        "errors"
      ]
    },
    "TelemetrySettings": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "revision": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9223372036854775807
        },
        "collection_seconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 60,
          "default": 30
        },
        "http_report_seconds": {
          "type": "integer",
          "minimum": 30,
          "maximum": 180,
          "default": 60
        },
        "wss_report_seconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 5,
          "default": 2
        },
        "connection_mode": {
          "type": "string",
          "enum": [
            "auto_http_wss"
          ]
        },
        "log_level": {
          "type": "string",
          "enum": [
            "debug",
            "info",
            "warn",
            "error"
          ],
          "description": "Agent logging threshold; omitted defaults to warn.",
          "default": "warn"
        },
        "traffic": {
          "$ref": "#/$defs/TelemetryTrafficSettings"
        }
      },
      "required": [
        "revision",
        "collection_seconds",
        "http_report_seconds",
        "wss_report_seconds",
        "connection_mode"
      ]
    },
    "TelemetrySettingsResult": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "revision": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9223372036854775807
        },
        "applied_revision": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9223372036854775807
        },
        "state": {
          "type": "string",
          "enum": [
            "applied",
            "failed"
          ]
        },
        "error_code": {
          "type": "string",
          "enum": [
            "invalid_settings",
            "stale_revision",
            "revision_conflict",
            "persist_failed"
          ]
        }
      },
      "required": [
        "revision",
        "applied_revision",
        "state"
      ],
      "allOf": [
        {
          "if": {
            "properties": {
              "state": {
                "const": "applied"
              }
            }
          },
          "then": {
            "not": {
              "required": [
                "error_code"
              ]
            }
          },
          "else": {
            "required": [
              "error_code"
            ]
          }
        }
      ]
    },
    "TelemetryInterface": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[A-Za-z0-9_.:-]+$"
        },
        "ifindex": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4294967295
        },
        "rx_bytes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9223372036854775807
        },
        "tx_bytes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9223372036854775807
        },
        "rx_bytes_per_second": {
          "type": "number",
          "minimum": 0,
          "maximum": 1e+20
        },
        "tx_bytes_per_second": {
          "type": "number",
          "minimum": 0,
          "maximum": 1e+20
        },
        "quality": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "baseline",
              "partial",
              "counter_reset",
              "identity_changed",
              "period_gap",
              "boundary_estimated",
              "mixed_filter",
              "persist_failed",
              "unknown"
            ]
          },
          "maxItems": 9,
          "uniqueItems": true
        }
      },
      "required": [
        "name",
        "ifindex",
        "rx_bytes",
        "tx_bytes",
        "quality"
      ]
    },
    "TelemetryTraffic": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "month_start": {
          "type": "string",
          "format": "date-time"
        },
        "rx_bytes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9223372036854775807
        },
        "tx_bytes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9223372036854775807
        },
        "filter_revision": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[a-f0-9]{64}$"
        },
        "quality": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "baseline",
              "partial",
              "counter_reset",
              "identity_changed",
              "period_gap",
              "boundary_estimated",
              "mixed_filter",
              "persist_failed",
              "unknown"
            ]
          },
          "maxItems": 9,
          "uniqueItems": true
        },
        "period_end": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "month_start",
        "filter_revision",
        "quality"
      ]
    },
    "TelemetryFast": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "sequence": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9223372036854775807
        },
        "sampled_at": {
          "type": "string",
          "format": "date-time"
        },
        "elapsed_seconds": {
          "type": "number",
          "minimum": 0,
          "maximum": 600
        },
        "cpu_percent": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        "ram_total": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9223372036854775807
        },
        "ram_used": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9223372036854775807
        },
        "swap_total": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9223372036854775807
        },
        "swap_used": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9223372036854775807
        },
        "uptime_seconds": {
          "type": "number",
          "minimum": 0,
          "maximum": 1e+20
        },
        "tcp_inuse": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1048576
        },
        "udp_inuse": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1048576
        },
        "interfaces": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/TelemetryInterface"
          },
          "maxItems": 64
        },
        "filter_revision": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[a-f0-9]{64}$"
        },
        "traffic": {
          "$ref": "#/$defs/TelemetryTraffic"
        },
        "errors": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "cpu_unavailable",
              "memory_unavailable",
              "uptime_unavailable",
              "network_unavailable",
              "sockets_unavailable",
              "traffic_unavailable",
              "unsupported_platform"
            ]
          },
          "maxItems": 7,
          "uniqueItems": true
        }
      },
      "required": [
        "sequence",
        "sampled_at",
        "elapsed_seconds",
        "interfaces",
        "filter_revision",
        "errors"
      ]
    },
    "TelemetryDiskIO": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "read_bytes_per_second": {
          "type": "number",
          "minimum": 0,
          "maximum": 1e+20
        },
        "write_bytes_per_second": {
          "type": "number",
          "minimum": 0,
          "maximum": 1e+20
        },
        "read_iops": {
          "type": "number",
          "minimum": 0,
          "maximum": 1e+20
        },
        "write_iops": {
          "type": "number",
          "minimum": 0,
          "maximum": 1e+20
        },
        "read_await_ms": {
          "type": "number",
          "minimum": 0,
          "maximum": 1e+20
        },
        "write_await_ms": {
          "type": "number",
          "minimum": 0,
          "maximum": 1e+20
        },
        "await_ms": {
          "type": "number",
          "minimum": 0,
          "maximum": 1e+20
        },
        "util_percent": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        "quality": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "baseline",
              "partial",
              "counter_reset",
              "identity_changed",
              "period_gap",
              "boundary_estimated",
              "mixed_filter",
              "persist_failed",
              "unknown"
            ]
          },
          "maxItems": 9,
          "uniqueItems": true
        }
      },
      "required": [
        "quality"
      ]
    },
    "TelemetryFull": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "sequence": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9223372036854775807
        },
        "sampled_at": {
          "type": "string",
          "format": "date-time"
        },
        "elapsed_seconds": {
          "type": "number",
          "minimum": 0,
          "maximum": 600
        },
        "load_1": {
          "type": "number",
          "minimum": 0,
          "maximum": 1e+20
        },
        "load_5": {
          "type": "number",
          "minimum": 0,
          "maximum": 1e+20
        },
        "load_15": {
          "type": "number",
          "minimum": 0,
          "maximum": 1e+20
        },
        "processes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1048576
        },
        "disk_total": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9223372036854775807
        },
        "disk_used": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9223372036854775807
        },
        "disk_available": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9223372036854775807
        },
        "disk_io": {
          "$ref": "#/$defs/TelemetryDiskIO"
        },
        "os_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "os_name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "os_version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "errors": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "load_unavailable",
              "processes_unavailable",
              "disk_unavailable",
              "disk_io_unavailable",
              "os_unavailable",
              "unsupported_platform"
            ]
          },
          "maxItems": 6,
          "uniqueItems": true
        }
      },
      "required": [
        "sequence",
        "sampled_at",
        "elapsed_seconds",
        "errors"
      ]
    },
    "TelemetryPublicIP": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "sequence": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9223372036854775807
        },
        "sampled_at": {
          "type": "string",
          "format": "date-time"
        },
        "ipv4": {
          "type": "string",
          "minLength": 1,
          "maxLength": 45,
          "format": "ipv4"
        },
        "ipv6": {
          "type": "string",
          "minLength": 1,
          "maxLength": 45,
          "format": "ipv6"
        },
        "errors": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "ipv4_unavailable",
              "ipv6_unavailable"
            ]
          },
          "maxItems": 2,
          "uniqueItems": true
        }
      },
      "required": [
        "sequence",
        "sampled_at",
        "errors"
      ]
    },
    "TelemetryBatch": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "node_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
        },
        "run_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 36,
          "format": "uuid",
          "pattern": "^[a-fA-F0-9]{8}-[a-fA-F0-9]{4}-4[a-fA-F0-9]{3}-[89abAB][a-fA-F0-9]{3}-[a-fA-F0-9]{12}$"
        },
        "batch_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
        },
        "fast": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/TelemetryFast"
          },
          "maxItems": 300
        },
        "full": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/TelemetryFull"
          },
          "maxItems": 8
        },
        "public_ip": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/TelemetryPublicIP"
          },
          "maxItems": 2
        }
      },
      "required": [
        "node_id",
        "run_id",
        "batch_id",
        "fast",
        "full",
        "public_ip"
      ],
      "anyOf": [
        {
          "properties": {
            "fast": {
              "minItems": 1
            }
          }
        },
        {
          "properties": {
            "full": {
              "minItems": 1
            }
          }
        },
        {
          "properties": {
            "public_ip": {
              "minItems": 1
            }
          }
        }
      ]
    },
    "TelemetryReceipt": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "batch_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
        },
        "state": {
          "type": "string",
          "enum": [
            "accepted",
            "rejected"
          ]
        },
        "accepted_count": {
          "type": "integer",
          "minimum": 0,
          "maximum": 310
        },
        "duplicate_count": {
          "type": "integer",
          "minimum": 0,
          "maximum": 310
        },
        "error_code": {
          "type": "string",
          "enum": [
            "invalid_batch",
            "overloaded",
            "rate_limited",
            "session_expired",
            "session_invalid",
            "identity_revoked",
            "node_disabled",
            "unsupported_protocol",
            "stale_session",
            "stale_demand",
            "lease_expired"
          ]
        }
      },
      "required": [
        "batch_id",
        "state",
        "accepted_count",
        "duplicate_count"
      ],
      "allOf": [
        {
          "if": {
            "properties": {
              "state": {
                "const": "accepted"
              }
            }
          },
          "then": {
            "not": {
              "required": [
                "error_code"
              ]
            }
          },
          "else": {
            "required": [
              "error_code"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "state": {
                "const": "rejected"
              }
            }
          },
          "then": {
            "properties": {
              "accepted_count": {
                "const": 0
              },
              "duplicate_count": {
                "const": 0
              }
            }
          }
        }
      ]
    },
    "TelemetryDemand": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "session_generation": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
        },
        "demand_revision": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9223372036854775807
        },
        "lease_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
        },
        "enabled": {
          "type": "boolean"
        },
        "ttl_seconds": {
          "type": "integer",
          "minimum": 0,
          "maximum": 90
        }
      },
      "required": [
        "session_generation",
        "demand_revision",
        "lease_id",
        "enabled",
        "ttl_seconds"
      ],
      "allOf": [
        {
          "if": {
            "properties": {
              "enabled": {
                "const": true
              }
            }
          },
          "then": {
            "properties": {
              "ttl_seconds": {
                "const": 90
              }
            }
          },
          "else": {
            "properties": {
              "ttl_seconds": {
                "const": 0
              }
            }
          }
        }
      ]
    },
    "TelemetryDemandResult": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "session_generation": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
        },
        "demand_revision": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9223372036854775807
        },
        "lease_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
        },
        "state": {
          "type": "string",
          "enum": [
            "applied",
            "rejected"
          ]
        },
        "mode": {
          "type": "string",
          "enum": [
            "http",
            "realtime",
            "degraded"
          ]
        },
        "error_code": {
          "type": "string",
          "enum": [
            "stale_session",
            "stale_demand",
            "lease_expired",
            "invalid_settings"
          ]
        }
      },
      "required": [
        "session_generation",
        "demand_revision",
        "lease_id",
        "state",
        "mode"
      ],
      "allOf": [
        {
          "if": {
            "properties": {
              "state": {
                "const": "applied"
              }
            }
          },
          "then": {
            "not": {
              "required": [
                "error_code"
              ]
            }
          },
          "else": {
            "required": [
              "error_code"
            ]
          }
        }
      ]
    },
    "TelemetryReady": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "session_generation": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
        },
        "settings": {
          "$ref": "#/$defs/TelemetrySettings"
        }
      },
      "required": [
        "session_generation",
        "settings"
      ]
    },
    "TelemetryTrafficSettings": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "interfaces": {
          "type": "string",
          "maxLength": 4159
        },
        "reset_day": {
          "type": "integer",
          "minimum": 1,
          "maximum": 31
        },
        "reset_hour": {
          "type": "integer",
          "minimum": 0,
          "maximum": 23
        },
        "reset_minute": {
          "type": "integer",
          "minimum": 0,
          "maximum": 59
        },
        "timezone": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "billing_mode": {
          "type": "string",
          "enum": [
            "both",
            "outbound",
            "inbound"
          ]
        },
        "quota_bytes": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]{0,18})$"
        }
      },
      "required": [
        "interfaces",
        "reset_day",
        "reset_hour",
        "reset_minute",
        "timezone",
        "billing_mode",
        "quota_bytes"
      ]
    },
    "TrafficCalibration": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "period_start": {
          "type": "string",
          "format": "date-time"
        },
        "rx_bytes": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]{0,18})$"
        },
        "tx_bytes": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]{0,18})$"
        }
      },
      "required": [
        "period_start",
        "rx_bytes",
        "tx_bytes"
      ]
    }
  }
}
