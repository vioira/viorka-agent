{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vioira.example/spec/viorka/agent/v1/envelope.schema.json",
  "title": "Viorka Agent Protocol v1 Envelope (design contract)",
  "description": "\u6d88\u606f\u5305\u88c5\u7ed3\u6784\u3002\u7ea6\u5b9a\u534f\u8bae\u76ee\u6807\uff0cM0 \u671f\u95f4\u5b9e\u73b0\u63e1\u624b\u548c\u7aef\u5230\u7aef\u8054\u6d4b\u3002",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "message_id",
    "type",
    "sent_at",
    "payload"
  ],
  "properties": {
    "version": {
      "type": "string",
      "const": "1.0"
    },
    "message_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "type": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*)+$"
    },
    "node_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "correlation_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "sent_at": {
      "type": "string",
      "format": "date-time"
    },
    "revision": {
      "type": "integer",
      "minimum": 0
    },
    "payload": {
      "type": "object"
    }
  },
  "$defs": {
    "Hello": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "agent_version": {
          "type": "string"
        },
        "protocol_versions": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "maxItems": 32
        },
        "capabilities": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "maxItems": 32
        },
        "os": {
          "type": "string"
        },
        "arch": {
          "type": "string"
        }
      },
      "required": [
        "agent_version",
        "protocol_versions",
        "capabilities",
        "os",
        "arch"
      ]
    },
    "HelloAck": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "protocol_version": {
          "type": "string"
        },
        "heartbeat_seconds": {
          "type": "integer",
          "minimum": 0
        },
        "metrics_version": {
          "type": "integer",
          "enum": [
            1,
            2
          ]
        },
        "inventory_version": {
          "type": "integer",
          "enum": [
            1
          ]
        },
        "node_settings": {
          "$ref": "#/$defs/LegacyNodeSettings"
        },
        "collection_settings": {
          "$ref": "#/$defs/NodeSettings"
        },
        "host_metrics_version": {
          "type": "integer",
          "const": 1
        }
      },
      "required": [
        "protocol_version",
        "heartbeat_seconds"
      ]
    },
    "Heartbeat": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "observed_config_revision": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "observed_config_revision"
      ]
    },
    "TaskDispatch": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "task_id": {
          "type": "string"
        },
        "operation": {
          "type": "string"
        },
        "idempotency_key": {
          "type": "string"
        },
        "resource_kind": {
          "type": "string"
        },
        "resource_id": {
          "type": "string"
        },
        "config_sha256": {
          "type": "string"
        },
        "deadline_at": {
          "type": "string",
          "format": "date-time"
        },
        "attempt": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "task_id",
        "operation",
        "idempotency_key",
        "resource_kind",
        "resource_id",
        "deadline_at"
      ]
    },
    "Inspection": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "os": {
          "type": "string"
        },
        "arch": {
          "type": "string"
        },
        "hostname": {
          "type": "string"
        }
      },
      "required": [
        "os",
        "arch",
        "hostname"
      ]
    },
    "TaskReply": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "task_id": {
          "type": "string"
        },
        "attempt": {
          "type": "integer",
          "minimum": 0
        },
        "resource_id": {
          "type": "string"
        },
        "state": {
          "type": "string"
        },
        "inspection": {
          "$ref": "#/$defs/Inspection"
        },
        "error_code": {
          "type": "string"
        }
      },
      "required": [
        "task_id",
        "attempt",
        "resource_id",
        "state"
      ]
    },
    "CPUMetrics": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "usage_percent": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        "logical_cpus": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1048576
        }
      },
      "required": [
        "logical_cpus"
      ]
    },
    "MemoryMetrics": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "total_bytes": {
          "type": "number",
          "minimum": 0
        },
        "available_bytes": {
          "type": "number",
          "minimum": 0
        },
        "used_bytes": {
          "type": "number",
          "minimum": 0
        },
        "swap_total_bytes": {
          "type": "number",
          "minimum": 0
        },
        "swap_used_bytes": {
          "type": "number",
          "minimum": 0
        }
      },
      "required": [
        "total_bytes",
        "available_bytes",
        "used_bytes",
        "swap_total_bytes",
        "swap_used_bytes"
      ]
    },
    "LoadMetrics": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "one": {
          "type": "number",
          "minimum": 0
        },
        "five": {
          "type": "number",
          "minimum": 0
        },
        "fifteen": {
          "type": "number",
          "minimum": 0
        }
      },
      "required": [
        "one",
        "five",
        "fifteen"
      ]
    },
    "DiskMetrics": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "total_bytes": {
          "type": "number",
          "minimum": 0
        },
        "used_bytes": {
          "type": "number",
          "minimum": 0
        },
        "available_bytes": {
          "type": "number",
          "minimum": 0
        }
      },
      "required": [
        "total_bytes",
        "used_bytes",
        "available_bytes"
      ]
    },
    "InterfaceMetrics": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "rx_bytes": {
          "type": "number",
          "minimum": 0
        },
        "tx_bytes": {
          "type": "number",
          "minimum": 0
        },
        "rx_bytes_per_second": {
          "type": "number",
          "minimum": 0
        },
        "tx_bytes_per_second": {
          "type": "number",
          "minimum": 0
        }
      },
      "required": [
        "name",
        "rx_bytes",
        "tx_bytes"
      ]
    },
    "NodeMetrics": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "sampled_at": {
          "type": "string",
          "format": "date-time"
        },
        "interval_seconds": {
          "type": "number",
          "minimum": 0,
          "maximum": 600
        },
        "cpu": {
          "$ref": "#/$defs/CPUMetrics"
        },
        "memory": {
          "$ref": "#/$defs/MemoryMetrics"
        },
        "load": {
          "$ref": "#/$defs/LoadMetrics"
        },
        "disk": {
          "$ref": "#/$defs/DiskMetrics"
        },
        "uptime_seconds": {
          "type": "number",
          "minimum": 0
        },
        "interfaces": {
          "type": "array",
          "maxItems": 64,
          "items": {
            "$ref": "#/$defs/InterfaceMetrics"
          }
        },
        "errors": {
          "type": "array",
          "maxItems": 8,
          "items": {
            "type": "string",
            "enum": [
              "cpu_unavailable",
              "memory_unavailable",
              "load_unavailable",
              "disk_unavailable",
              "uptime_unavailable",
              "network_unavailable",
              "unsupported_platform"
            ]
          }
        },
        "host": {
          "$ref": "#/$defs/HostMetrics"
        }
      },
      "required": [
        "sampled_at",
        "interval_seconds",
        "errors",
        "interfaces"
      ]
    },
    "NodeInventory": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "sampled_at": {
          "type": "string",
          "format": "date-time"
        },
        "os_id": {
          "type": "string",
          "maxLength": 64
        },
        "os_name": {
          "type": "string",
          "maxLength": 256
        },
        "os_version": {
          "type": "string",
          "maxLength": 64
        },
        "public_ipv4": {
          "type": "string",
          "maxLength": 45
        },
        "public_ipv6": {
          "type": "string",
          "maxLength": 45
        },
        "errors": {
          "type": "array",
          "maxItems": 3,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "enum": [
              "os_release_unavailable",
              "public_ipv4_unavailable",
              "public_ipv6_unavailable"
            ]
          }
        }
      },
      "required": [
        "sampled_at",
        "os_id",
        "os_name",
        "os_version",
        "public_ipv4",
        "public_ipv6",
        "errors"
      ]
    },
    "NodeSettings": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "revision": {
          "type": "integer",
          "minimum": 1
        },
        "collection_seconds": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10
        },
        "report_seconds": {
          "type": "integer",
          "minimum": 30,
          "maximum": 180
        },
        "connection_mode": {
          "type": "string",
          "enum": [
            "wss"
          ]
        },
        "wss_report_seconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 5
        }
      },
      "required": [
        "revision",
        "collection_seconds",
        "report_seconds",
        "connection_mode",
        "wss_report_seconds"
      ]
    },
    "LegacyNodeSettings": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "revision": {
          "type": "integer",
          "minimum": 1
        },
        "collection_seconds": {
          "type": "integer",
          "minimum": 10,
          "maximum": 300
        },
        "report_seconds": {
          "type": "integer",
          "minimum": 60,
          "maximum": 3600
        },
        "connection_mode": {
          "type": "string",
          "enum": [
            "wss"
          ]
        },
        "wss_report_seconds": {
          "type": "integer",
          "minimum": 10,
          "maximum": 300
        }
      },
      "required": [
        "revision",
        "collection_seconds",
        "report_seconds",
        "connection_mode",
        "wss_report_seconds"
      ]
    },
    "NodeMetricsBatch": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "samples": {
          "type": "array",
          "minItems": 1,
          "maxItems": 10,
          "items": {
            "$ref": "#/$defs/NodeMetrics"
          }
        }
      },
      "required": [
        "samples"
      ]
    },
    "DiskIOMetrics": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "device": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "read_bytes": {
          "type": "number",
          "minimum": 0
        },
        "write_bytes": {
          "type": "number",
          "minimum": 0
        },
        "read_bytes_per_second": {
          "type": "number",
          "minimum": 0
        },
        "write_bytes_per_second": {
          "type": "number",
          "minimum": 0
        }
      },
      "required": [
        "device",
        "read_bytes",
        "write_bytes"
      ]
    },
    "HostMetrics": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "disk_io": {
          "type": "array",
          "maxItems": 64,
          "items": {
            "$ref": "#/$defs/DiskIOMetrics"
          }
        },
        "tcp_sockets": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1048576
        },
        "udp_sockets": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1048576
        },
        "processes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1048576
        },
        "errors": {
          "type": "array",
          "maxItems": 3,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "enum": [
              "disk_io_unavailable",
              "sockets_unavailable",
              "processes_unavailable"
            ]
          }
        }
      },
      "required": [
        "disk_io",
        "errors"
      ]
    }
  }
}
